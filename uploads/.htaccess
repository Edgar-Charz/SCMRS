# Deny all direct HTTP access to uploaded files.
# PHP's readfile() in download_attachment.php bypasses this and still works.

# Apache 2.4
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 fallback
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# Disable PHP execution in case a malicious file slips through
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
Options -ExecCGI
RemoveHandler .php .php3 .php4 .php5 .php7 .phtml .phar
